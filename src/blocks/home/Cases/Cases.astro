---
/** Casos de estudio (src/data/cases.ts). Lo usan la home y las páginas de servicio.
 * Abren en otra pestaña: viven en aurin.mx y así el visitante no pierde esta página (ni el formulario). */
import type { CaseCard } from '@/data/cases';
import { serviceById } from '@/data/services';
import { getLangFromUrl } from '@/i18n';
import styles from './Cases.module.css';
import Accent from '@/components/ui/Accent.astro';

interface Props {
  cases: { heading: string; link: string; items: CaseCard[] };
  /** Páginas de servicio: pocos casos en tarjetas, sin nombre ni logo del cliente (solo qué hicimos). */
  cards?: boolean;
}

const { cases, cards } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const services = (item: CaseCard) => item.services.map((id) => serviceById(id).copy[lang].name).join(', ');
---

<section id="casos" class:list={['sky', 'sky-stars', styles.section]} aria-labelledby="title-cases">
  <div class="wrap">
    <h2 id="title-cases" class:list={['h2', styles.heading]}><Accent text={cases.heading} /></h2>
    {cards ? (
      <>
        <ul class={styles.cards}>
          {cases.items.map((item, i) => (
            <li class:list={['reveal', styles.card]}>
              <span class={styles.cardTop}>
                <span class={styles.industry}>{item.industry}</span>
                <span class={styles.industry} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <h3 class={styles.cardName}>{item.project ?? item.name}</h3>
              <p class={styles.meta}>{services(item)}</p>
            </li>
          ))}
        </ul>
      </>
    ) : (
    <ul class={styles.list}>
      {cases.items.map((item) => (
        <li>
          <a class:list={['reveal', styles.case]} href={item.href} target="_blank" rel="noopener">
            <span>
              <span class={styles.name}>{item.name}</span>
              <span class={styles.meta}>{item.industry} · {services(item)}</span>
            </span>
            <span class:list={['muted', styles.text]}>{item.text}</span>
            <span class={styles.link}>{cases.link} <span class={styles.arrow} aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ul>
    )}
  </div>
</section>

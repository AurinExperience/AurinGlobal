---
/** Industrias con clientes reales: las primeras 6 y "Ver todas" a /industrias/, donde están todas con buscador. */
import type { Industry } from '@/data/home';
import { industriesPath } from '@/data/industries';
import { UI, getLangFromUrl } from '@/i18n';
import IndustryCards from '@/blocks/shared/IndustryCards/IndustryCards.astro';
import SecondaryButton from '@/components/ui/SecondaryButton.astro';
import styles from './IndustriesGrid.module.css';
import Accent from '@/components/ui/Accent.astro';

interface Props {
  industries: { heading: string; intro?: string; items: Industry[] };
}

const { industries } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<section id="industrias" class:list={['sky', styles.section]} aria-labelledby="title-industries">
  <div class="wrap">
    <div class={styles.head}>
      <h2 id="title-industries" class:list={['h2', styles.heading]}><Accent text={industries.heading} /></h2>
      {industries.intro && <p class:list={['muted', styles.intro]}>{industries.intro}</p>}
    </div>
    <IndustryCards items={industries.items.slice(0, 6)} />
    <div class={styles.more}><SecondaryButton href={industriesPath(lang)} text={UI[lang].industries.more} /></div>
  </div>
</section>

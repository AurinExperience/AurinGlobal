---
import type { HomeCopy } from '@/data/home';
import styles from './UsTeam.module.css';

interface Props {
  us: HomeCopy['us'];
}

const { us } = Astro.props;
---

<section class={styles.section} aria-labelledby="titulo-eeuu">
  <div class="wrap">
    <p class="eyebrow">{us.eyebrow}</p>
    <h2 id="titulo-eeuu" class:list={['h2', styles.heading]}>{us.heading}</h2>
    <div class={styles.grid}>
      {us.items.map((item, i) => (
        <div class:list={['reveal', styles.card]}>
          <span class={styles.num} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class:list={['h3', styles.title]}>{item.title}</h3>
          <p class:list={['muted', styles.text]}>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

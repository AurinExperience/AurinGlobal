---
import type { StateCopy } from '@/data/states/types';
import styles from './UsTeam.module.css';
import Accent from '@/components/ui/Accent.astro';

interface Props {
  /** Por qué Aurin en el estado (`why`). La home ya no lo usa: lo cubren Equipo, Proceso e IA. */
  us: StateCopy['why'];
}

const { us } = Astro.props;
---

<section class:list={['sky', styles.section]} aria-labelledby="title-us">
  <div class="wrap">
    <h2 id="title-us" class:list={['h2', styles.heading]}><Accent text={us.heading} /></h2>
    <div class={styles.grid}>
      {us.items.map((item, i) => (
        <div class:list={['reveal', 'spotlight', styles.card]}>
          <span class={styles.num} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class:list={['h3', styles.title]}>{item.title}</h3>
          <p class:list={['muted', styles.text]}>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

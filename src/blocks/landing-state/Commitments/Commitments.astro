---
/**
 * Lo que va por escrito (landings por estado), negra: título y botón a la izquierda; a la derecha una hoja blanca, como la
 * propuesta misma, con sus puntos y dos líneas de firma. Quita el miedo a contratar a distancia antes del equipo y el FAQ.
 * Los servicios usan Guarantees (franja lima): aquí iría pegada al proceso, que ya es lima.
 */
import type { StateCopy } from '@/data/states/types';
import Accent from '@/components/ui/Accent.astro';
import MainButton from '@/components/ui/MainButton.astro';
import { UI, getLangFromUrl } from '@/i18n';
import styles from './Commitments.module.css';

interface Props {
  commitments: StateCopy['commitments'];
}

const { commitments } = Astro.props;
const t = UI[getLangFromUrl(Astro.url)];
---

<section class={styles.section} aria-labelledby="title-commitments">
  <div class:list={['wrap', styles.grid]}>
    <div class={styles.aside}>
      <h2 id="title-commitments" class:list={['h2', styles.heading]}><Accent text={commitments.heading} /></h2>
      <p class:list={['muted', styles.intro]}>{commitments.intro}</p>
      <div class={styles.cta}>
        <MainButton href="#contacto" text={t.bookCallLong} />
        <p class:list={['muted', styles.note]}>{t.process.note}</p>
      </div>
    </div>
    <div class:list={['reveal', styles.sheet]}>
      <p class={styles.sheetTitle}>{commitments.sheet}</p>
      <ol class={styles.items}>
        {commitments.items.map((item, i) => (
          <li class={styles.item}>
            <span class={styles.num} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class:list={['h3', styles.title]}>{item.title}</h3>
              <p class={styles.text}>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class={styles.signs} aria-hidden="true">
        <span>Aurin</span>
        <span>{commitments.you}</span>
      </div>
    </div>
  </div>
</section>

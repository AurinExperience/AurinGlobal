---
/**
 * Segunda sección de las páginas de servicio (blanca): el argumento de venta como comparación.
 * Izquierda "lo de siempre" en gris; derecha lo que hacemos, en negro con la luz lima.
 */
import type { ServiceCopy } from '@/data/services/types';
import Accent from '@/components/ui/Accent.astro';
import Check from 'lucide-astro/Check';
import X from 'lucide-astro/X';
import styles from './Contrast.module.css';

interface Props {
  approach: ServiceCopy['approach'];
}

const { approach } = Astro.props;
const { bad, good } = approach.contrast!;
---

<section class={styles.section} aria-labelledby="title-approach">
  <div class="wrap">
    <div class={styles.head}>
      <h2 id="title-approach" class:list={['h2', styles.heading]}><Accent text={approach.heading} /></h2>
      <p class={styles.text}>{approach.text}</p>
    </div>
    <div class={styles.grid}>
      <div class:list={['reveal', styles.card, styles.bad]}>
        <p class={styles.label}>{bad.label}</p>
        <h3 class:list={['h3', styles.title]}>{bad.title}</h3>
        <ul class={styles.list}>
          {bad.items.map((item) => <li><span class={styles.mark} aria-hidden="true"><X size={16} stroke-width={2.2} /></span>{item}</li>)}
        </ul>
      </div>
      <div class:list={['reveal', styles.card, styles.good]}>
        <p class={styles.label}>{good.label}</p>
        <h3 class:list={['h3', styles.title]}>{good.title}</h3>
        <ul class={styles.list}>
          {good.items.map((item) => <li><span class={styles.mark} aria-hidden="true"><Check size={16} stroke-width={2.6} /></span>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

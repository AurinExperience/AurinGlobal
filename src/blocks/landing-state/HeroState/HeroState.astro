    const scene = photo?.closest('div');
    const canvas = section?.querySelector('canvas');
    const gl = gpuContext(canvas);
    if (!section || !photo || !scene || !canvas || !gl) return;
    const u = await setup(gl, FRAG, ['img', 'r', 's', 'off', 'texel', 't', 'tgt', 'cur']);
    if (!u) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 1x en táctiles; en escritorio la resolución real (hasta 2x): a 1.5x, como HeroHome, la foto se veía borrosa
    const maxScale = matchMedia('(pointer: coarse)').matches ? 1 : 2;
    let raf = 0;
    let t0 = 0;

    function draw(time: number) {
      gl!.uniform1f(u!.t, reduce ? 6 : time);
      // Con reduced-motion, el código completo y sin cursor
      if (FX === 'code') gl!.uniform3f(u!.cur, ...((reduce ? [CODE_ROWS.length, 0, 0] : cursorAt(time)) as [number, number, number]));
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    // Posición en la página sin transforms (offset*)
    function at(el: HTMLElement) {
      let x = 0, y = 0;
      for (let e: HTMLElement | null = el; e; e = e.offsetParent as HTMLElement | null) { x += e.offsetLeft; y += e.offsetTop; }
      return [x, y];
    }

    // Mismo recorte que object-fit: cover + object-position del CSS, sobre la escena (más ancha que la sección)
    function resize() {
      const k = Math.min(devicePixelRatio, maxScale);
      const w = Math.round(scene!.clientWidth * k);
      const h = Math.round(scene!.clientHeight * k);
      // Cambiar el tamaño borra el lienzo: solo si de verdad cambió (si no, parpadea)
      if (canvas!.width !== w || canvas!.height !== h) [canvas!.width, canvas!.height] = [w, h];
      gl!.viewport(0, 0, w, h);
      const ratio = w / h;
      const img = IMG[0] / IMG[1];
      const s = ratio > img ? [1, img / ratio] : [ratio / img, 1];
      gl!.uniform2f(u!.r, w, h);
      gl!.uniform2f(u!.s, s[0], s[1]);
      const pos = getComputedStyle(photo!).objectPosition.split(' ').map((v) => parseFloat(v) / 100);
      gl!.uniform2f(u!.off, (1 - s[0]) * pos[0], (1 - s[1]) * pos[1]);
      // El haz de la lámpara apunta al botón de la llamada: su centro, pasado a coordenadas de la foto. En celular el
      // cirujano queda debajo de los botones: ahí el haz sale hacia la izquierda, como apunta la lámpara
      const button = section!.querySelector<HTMLElement>('[data-hero-cta] a');
      if (LAMP && matchMedia('(max-width: 900px)').matches) gl!.uniform2f(u!.tgt, LAMP[0] - .2, LAMP[1] + .05);
      else if (button) {
        // Con offset* y no getBoundingClientRect: la animación de entrada de los botones (translate) no mueve el haz
        const [bx, by] = at(button), [sx, sy] = at(scene!);
        gl!.uniform2f(u!.tgt,
          (1 - s[0]) * pos[0] + (bx + button.offsetWidth * .5 - sx) / scene!.offsetWidth * s[0],
          (1 - s[1]) * pos[1] + (by + button.offsetHeight * .5 - sy) / scene!.offsetHeight * s[1]);
      }
      draw(t0 ? (performance.now() - t0) / 1000 : 0);
    }

    function frame(now: number) {
      t0 ||= now;
      draw((now - t0) / 1000);
      raf = requestAnimationFrame(frame);
    }

    photo.decode().then(() => {
      gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, photo);
      gl.uniform2f(u.texel, 1 / photo.naturalWidth, 1 / photo.naturalHeight);

      resize();
      // También el texto: cuando carga la tipografía crece y baja el botón al que apunta el haz
      const ro = new ResizeObserver(resize);
      ro.observe(scene);
      const copy = section.querySelector('[data-hero-cta]')?.parentElement;
      if (copy) ro.observe(copy);
      if (!reduce) {
        new IntersectionObserver(([entry]) => {
          cancelAnimationFrame(raf);
          raf = entry.isIntersecting ? requestAnimationFrame(frame) : 0;
        }).observe(section);
      }
      canvas.dataset.on = '';
    }, () => {});
  }

  init();
</script>

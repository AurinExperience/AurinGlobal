    const float CODE_Y = ${CODE_Y.toFixed(1)}, CODE_LINE = ${CODE_LINE}, CODE_N = ${CODE_ROWS.length}.;
    void main() {
      vec2 uv = off + vec2(gl_FragCoord.x / r.x, 1. - gl_FragCoord.y / r.y) * s;

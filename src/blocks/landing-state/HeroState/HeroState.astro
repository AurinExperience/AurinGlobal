    const total = CODE_ROWS.reduce((sum, [a, b]) => sum + (b - a) / PX + PAUSE, 0) + HOLD;
    let x = time % total;
    for (let i = 0; i < CODE_ROWS.length; i++) {
      const [a, b] = CODE_ROWS[i], d = (b - a) / PX;
      if (x < d) return [i, a + x * PX, 1];
      x -= d;
      if (x < PAUSE) return [i, b + 3, 1];

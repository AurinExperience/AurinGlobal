---
/**
 * Formulario de las landings y páginas de servicio. Envía a /api/contact (correo con Resend).
 * Con JS manda por fetch y muestra el resultado en un modal (abajo del formulario no se veía);
 * sin JS es un POST normal y el endpoint regresa a la página con ?enviado=1|0, y el modal se abre
 * igual. `source` dice de qué página vino el lead.
 */
import { UI, getLangFromUrl } from '@/i18n';
import MainButton from '@/components/ui/MainButton.astro';
import PhoneInput from '@/components/ui/PhoneInput.astro';
import EmailInput from '@/components/ui/EmailInput.astro';
import { privacyPath } from '@/data/privacy';
import Check from 'lucide-astro/Check';
import X from 'lucide-astro/X';
import styles from './LeadForm.module.css';

interface Props {
  /** Origen del lead, p. ej. "landing-texas". */
  source: string;
  /** Sin el párrafo bajo el título: en el cierre de la home ya lo dice el texto de al lado. */
  intro?: boolean;
}

const { source, intro = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = UI[lang];
---

<form id="contacto" class:list={['rise rise-3', styles.form]} aria-labelledby="titulo-formulario" method="post" action="/api/contact/" data-lead-form={source}>
  <h2 id="titulo-formulario" class:list={['h3', styles.title]}>{t.form.title}</h2>
  {intro && <p class:list={['muted', styles.intro]}>{t.form.intro}</p>}
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="lang" value={lang} />
  {/* Trampa para bots: oculto para personas y lectores de pantalla */}
  <input class={styles.trap} type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  {/* Mismos campos que el LeadForm de aurin.mx. Los obligatorios llevan * en lima. */}
  <div class={styles.row}>
    <label class={styles.field}><span class={styles.label}>{t.form.name} <span class={styles.required} aria-hidden="true">*</span></span>
      <input class={styles.control} type="text" name="name" autocomplete="name" placeholder={t.form.namePlaceholder} required /></label>
    <div class={styles.field}>
      <label class={styles.label} for="lead-email">{t.form.email} <span class={styles.required} aria-hidden="true">*</span></label>
      <EmailInput id="lead-email" name="email" placeholder={t.form.emailPlaceholder} inputClass={styles.control} />
    </div>
  </div>
  {/* Teléfono solo (lada + número necesitan el ancho); los dos selects juntos */}
  <div class={styles.field}>
    <label class={styles.label} for="lead-phone">{t.form.phone} <span class={styles.required} aria-hidden="true">*</span></label>
    <PhoneInput id="lead-phone" name="phone" placeholder="(555) 123-4567" inputClass={styles.control} selectClass={styles.control} />
  </div>
  <div class={styles.row}>
    <label class={styles.field}><span class={styles.label}>{t.form.contactPref} <span class={styles.required} aria-hidden="true">*</span></span>
      <select class={styles.control} name="contactPref" required>
        <option value="" disabled selected>{t.form.select}</option>
        {t.form.contactPrefs.map((option) => <option>{option}</option>)}
      </select></label>
    <label class={styles.field}><span class={styles.label}>{t.form.need} <span class={styles.required} aria-hidden="true">*</span></span>
      <select class={styles.control} name="service" required>
        <option value="" disabled selected>{t.form.select}</option>
        {t.form.options.map((option) => <option>{option}</option>)}
      </select></label>
  </div>
  <label class={styles.field}><span class={styles.label}>{t.form.message}</span>
    <textarea class={styles.control} name="message" rows="2" maxlength="2000" placeholder={t.form.messagePlaceholder}></textarea></label>
  <MainButton type="submit" text={t.bookCallLong} class={styles.submit} />
  <p class={styles.note}>{t.form.privacyBefore}<a href={privacyPath(lang)}>{t.form.privacyLink}</a>{t.form.privacyAfter}</p>
  <p class={styles.status} role="status" data-status data-sending={t.form.sending}></p>
</form>

{/* Fuera del <form>: el cierre es un <form method="dialog"> y no se pueden anidar */}
<dialog class={styles.dialog} aria-labelledby="lead-dialog-title" closedby="any" data-lead-dialog>
  <span class={styles.icon} aria-hidden="true"><Check class={styles.iconSuccess} /><X class={styles.iconError} /></span>
  <p id="lead-dialog-title" class:list={['h3', styles.dialogTitle]} data-title-success={t.form.successTitle} data-title-error={t.form.errorTitle}></p>
  <p class:list={['muted', styles.dialogText]} data-text-success={t.form.success} data-text-error={t.form.error}></p>
  <form method="dialog"><MainButton type="submit" text={t.form.close} class={styles.submit} /></form>
</dialog>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lead-form]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const dialog = form.nextElementSibling as HTMLDialogElement;
    const title = dialog.querySelector<HTMLElement>('h2')!;
    const text = dialog.querySelector<HTMLElement>('p')!;
    const show = (state: 'success' | 'error') => {
      status.textContent = '';
      dialog.dataset.state = state;
      title.textContent = title.dataset[`title${state === 'success' ? 'Success' : 'Error'}`]!;
      text.textContent = text.dataset[`text${state === 'success' ? 'Success' : 'Error'}`]!;
      dialog.showModal();
    };

    // Vuelta del envío sin JS: se quita ?enviado para que recargar no vuelva a abrir el modal
    const sent = new URLSearchParams(location.search).get('enviado');
    if (sent) {
      show(sent === '1' ? 'success' : 'error');
      history.replaceState(null, '', location.pathname + location.hash);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = status.dataset.sending!;
      if (button) button.disabled = true;
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } }).catch(() => null);
      const ok = res?.ok && (await res.json().catch(() => null))?.ok;
      show(ok ? 'success' : 'error');
      if (ok) {
        // Conversión en GA4/Clarity (si hay analítica y consentimiento)
        (window as any).aurinTrack?.('generate_lead', { form_id: form.dataset.leadForm });
        form.reset();
      }
      if (button) button.disabled = false;
    });
  }
</script>

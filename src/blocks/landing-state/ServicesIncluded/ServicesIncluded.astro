---
/** Qué incluye el servicio: tarjetas con ícono (lucide), número y texto. */
import type { ServiceCopy } from '@/data/services/types';
import styles from './ServicesIncluded.module.css';
import Accent from '@/components/ui/Accent.astro';
import { ICONS } from '@/lib/icons';

interface Props {
  services: ServiceCopy['deliverables'];
  /** Fondo negro con tarjetas oscuras (cuando la sección anterior es blanca). */
  dark?: boolean;
  /** Para usarlo más de una vez en la misma página (tipos de sitio, soporte…). */
  id?: string;
}


const { services, dark, id = 'servicios' } = Astro.props;
---

<section id={id} class:list={[styles.section, dark && styles.dark]} aria-labelledby={`title-${id}`}>
  <div class="wrap">
    <div class={styles.head}>
      <h2 id={`title-${id}`} class:list={['h2', styles.heading]}><Accent text={services.heading} /></h2>
      {services.intro && <p class={styles.intro}>{services.intro}</p>}
    </div>
    <ul class={styles.grid}>
      {services.items.map((item, i) => {
        const Icon = item.icon ? ICONS[item.icon as keyof typeof ICONS] : undefined;
        return (
          <li class:list={['reveal', styles.item]}>
            <div class={styles.top}>
              {Icon && <span class={styles.icon} aria-hidden="true"><Icon size={24} stroke-width={1.6} /></span>}
              <span class={styles.num} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class:list={['h3', styles.title]}>{item.title}</h3>
            <p class={styles.text}>{item.text}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>

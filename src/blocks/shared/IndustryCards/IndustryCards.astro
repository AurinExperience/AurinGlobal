---
/** Retícula de industrias con sus clientes reales. La usan IndustriesGrid (home, estados) y /industrias/. */
import { clientLogo as logo, type Industry } from '@/data/home';
import { UI, getLangFromUrl } from '@/i18n';
import { INDUSTRY_PAGES } from '@/data/industries';
import { servicePath } from '@/data/services';
import styles from './IndustryCards.module.css';

interface Props {
  items: Industry[];
  /** id de la lista, para que el buscador de /industrias/ la encuentre. */
  id?: string;
}

const { items, id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = UI[lang];
const pageHref = (id?: string) => { const page = id && INDUSTRY_PAGES.find((p) => p.id === id); return page ? servicePath(page, lang) : undefined; };

const SCALE = .6;
const GAP = 24;
// Ancho de la fila de clientes (texto ≈ 7.5 px por letra). Si no cabe en la tarjeta (~300 px), se desliza.
const rowWidth = (names: string[]) => names.reduce((sum, name) => sum + (logo(name) ? logo(name)!.w * SCALE : name.length * 7.5) + GAP, 0);
---

<ul id={id} class={styles.grid}>
  {items.map((item) => (
    <li class:list={['reveal', 'spotlight', styles.item]}>
      {/* Con página propia, el título enlaza (el enlace cubre la tarjeta: .link::after) */}
      <h3 class="h3">{pageHref(item.page) ? <a class={styles.link} href={pageHref(item.page)}>{item.name}</a> : item.name}</h3>
      <p class:list={['muted', styles.text]}>{item.text}</p>
      <p class={styles.label}>{t.industries.clients}</p>
      {(() => {
        const names = item.clients.split(' · ');
        const slide = rowWidth(names) > 300;
        // Para deslizar sin salto, la lista va dos veces y avanza la mitad (la copia, oculta a lectores de pantalla)
        const copies = slide ? [false, true] : [false];
        return (
          <div class:list={[styles.clients, slide && styles.slide]}>
            <ul class={styles.track}>
              {copies.map((copy) => names.map((name) => {
                const l = logo(name);
                return <li aria-hidden={copy ? 'true' : undefined}>{l ? <img src={l.logo} alt={copy ? '' : name} data-tone={l.tone} width={Math.round(l.w * SCALE)} height={Math.round(l.h * SCALE)} loading="lazy" decoding="async" /> : name}</li>;
              }))}
            </ul>
          </div>
        );
      })()}
    </li>
  ))}
</ul>

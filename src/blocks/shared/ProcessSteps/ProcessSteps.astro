---
/** Sección lima del proceso. La home usa 4 pasos y las landings 3: el grid se adapta solo. */
import type { Step } from '@/data/types';
import styles from './ProcessSteps.module.css';
import Accent from '@/components/ui/Accent.astro';
import SecondaryButton from '@/components/ui/SecondaryButton.astro';
import { UI, getLangFromUrl } from '@/i18n';

interface Props {
  heading: string;
  steps: readonly Step[];
  /** Botón al formulario del cierre al final de los pasos (páginas de servicio). */
  cta?: boolean;
}

const { heading, steps, cta } = Astro.props;
const t = UI[getLangFromUrl(Astro.url)].process;
---

<section id="proceso" class={styles.section} aria-labelledby="titulo-proceso">
  <div class="wrap">
    <h2 id="titulo-proceso" class:list={['h2', styles.heading]}><Accent text={heading} /></h2>
    <ol class={styles.steps}>
      {steps.map((step, i) => (
        <li class="reveal">
          <span class={styles.num} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class:list={['h3', styles.name]}>{step.name}</h3>
          <p>{step.text}</p>
          {step.gets && <p class={styles.gets}><span class={styles.getsLabel}>{t.gets}</span>{step.gets}</p>}
        </li>
      ))}
    </ol>
    {cta && (
      <div class={styles.cta}>
        <SecondaryButton href="#contacto" text={t.cta} />
        <p class={styles.note}>{t.note}</p>
      </div>
    )}
  </div>
</section>

---
/** Cierre de página: "+Lejos" (motivo de marca). Mismo nombre que en aurin.mx. */
import { UI, getLangFromUrl } from '@/i18n';
import { SITE, whatsappUrl } from '@/config/site';
import MainButton from '@/components/ui/MainButton.astro';
import SecondaryButton from '@/components/ui/SecondaryButton.astro';
import styles from './CtaBanner.module.css';

interface Props {
  titleLead: string;
  titleAccent: string;
  /** Destino del botón principal: el formulario de la página o la sección de contacto. */
  href?: string;
  /** Sección blanca (sin cielo); el formulario queda como tarjeta negra. */
  light?: boolean;
}

const { titleLead, titleAccent, href = '#contacto', light = false } = Astro.props;
const t = UI[getLangFromUrl(Astro.url)];
// La home no tiene formulario arriba: lo pasa por el slot y ocupa el lugar del botón principal
const hasForm = Astro.slots.has('default');
---

<section class:list={[!light && 'sky', styles.section, hasForm && styles.withForm, light && styles.light]} aria-labelledby="title-cta">
  <div class="wrap">
    <div class={styles.lead}>
      <h2 id="title-cta" class:list={['h2', styles.title]}>{titleLead} <span class="accent">{titleAccent}</span></h2>
      <p class:list={['muted', styles.text]}>{t.ctaText}</p>
      {hasForm && (
        <div class={styles.next}>
          <h3 class={styles.nextTitle}>{t.ctaNext.title}</h3>
          <ol>{t.ctaNext.steps.map((step) => <li>{step}</li>)}</ol>
        </div>
      )}
    </div>
    {/* Con formulario, los otros canales bajan al pie de la columna, a la altura del botón de enviar */}
    <div class={styles.alt}>
      <div class="actions">
        {!hasForm && <MainButton href={href} text={t.bookCallLong} />}
        <SecondaryButton href={whatsappUrl(t.whatsappText, Astro.url.pathname)} text={t.whatsapp} newTab />
      </div>
      <p class={styles.mail}>{t.ctaMail} <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
    </div>
    <slot />
  </div>
</section>

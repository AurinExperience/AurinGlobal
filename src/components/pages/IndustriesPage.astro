---
/**
 * /industrias/ ↔ /en/industries/: todas las industrias de la home con buscador.
 * Sin JS se ven todas y el buscador no aparece.
 */
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CtaBanner from '@/components/layout/CtaBanner.astro';
import IndustryCards from '@/blocks/shared/IndustryCards/IndustryCards.astro';
import { HOME } from '@/data/home';
import { INDUSTRIES_INDEX, industriesPath } from '@/data/industries';
import { SITE } from '@/config/site';
import { UI, getLangFromUrl } from '@/i18n';
import Search from 'lucide-astro/Search';
import styles from './IndustriesPage.module.css';

const lang = getLangFromUrl(Astro.url);
const copy = INDUSTRIES_INDEX[lang];
const home = lang === 'en' ? '/en/' : '/';
const url = `${SITE.url}${industriesPath(lang)}`;
const items = HOME[lang].industries.items;

// CollectionPage con la lista de industrias (nombre + texto) y su ruta de migas
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.seo.description,
  url,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, description: item.text })),
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: UI[lang].home, item: `${SITE.url}${home}` },
    { '@type': 'ListItem', position: 2, name: copy.title, item: url },
  ],
};
---

<Layout title={copy.seo.title} description={copy.seo.description} structuredData={[schema, breadcrumb]}>
  <Header cta={`${home}#contacto`} />
  <main id="main-content">
    <section class:list={['sky', 'sky-stars', styles.section]} aria-labelledby="title-industries">
      <div class="wrap">
        <div class={styles.head}>
          <div>
            <h1 id="title-industries" class:list={['h1', styles.title]}>{copy.title}</h1>
            <p class:list={['muted', styles.intro]}>{copy.intro}</p>
          </div>
          <form class={styles.search} role="search" hidden>
            <label class="sr-only" for="industry-search">{copy.search}</label>
            <Search size={20} strokeWidth={1.5} aria-hidden="true" />
            <input id="industry-search" type="search" placeholder={copy.placeholder} autocomplete="off" />
          </form>
        </div>
        <IndustryCards id="lista-industrias" items={items} />
        <p id="sin-resultados" class={styles.empty} role="status" hidden>{copy.empty}</p>
      </div>
    </section>
    <CtaBanner {...HOME[lang].cta} href={`${home}#contacto`} />
  </main>
  <Footer />
</Layout>

<script>
  // Filtra las tarjetas por nombre, texto o cliente; ignora acentos y mayúsculas
  const form = document.querySelector<HTMLFormElement>('[role="search"]')!;
  const input = form.querySelector('input')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#lista-industrias > li')];
  const empty = document.getElementById('sin-resultados')!;
  const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  // Los clientes con logo solo tienen su nombre en el alt
  const texts = cards.map((card) => norm(`${card.textContent} ${[...card.querySelectorAll('img')].map((img) => img.alt).join(' ')}`));

  form.hidden = false;
  form.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', () => {
    const q = norm(input.value.trim());
    let shown = 0;
    cards.forEach((card, i) => {
      card.hidden = !texts[i].includes(q);
      if (!card.hidden) shown++;
    });
    empty.hidden = shown > 0;
  });
</script>

---
/**
 * Plantilla de las landings por estado. La usan pages/[estado].astro (ES) y
 * pages/en/[state].astro (EN). Este archivo no debe contener el nombre de
 * ningún estado: si lo contiene, algo se quedó fuera de src/data/states.
 *
 * JSON-LD: Service (areaServed con el estado y sus ciudades), HowTo del
 * proceso, BreadcrumbList y FAQPage. Organization y WebSite van en GlobalSchema.
 *
 * Los servicios enlazan a sus páginas (/diseno-web/…): la landing concentra la búsqueda
 * "agencia + estado" y le pasa autoridad a cada servicio.
 */
import type { State } from '@/data/states';
import type { ServiceId } from '@/data/services/types';
import { statePath, stateName, statesPath, siblingStates } from '@/data/states';
import { SERVICES, servicePath } from '@/data/services';
import { INDUSTRY_PAGES } from '@/data/industries';
import { caseCards } from '@/data/cases';
import { HOME } from '@/data/home';
import { SITE, ORG_ID } from '@/config/site';
import { UI, getLangFromUrl } from '@/i18n';
import { faqSchema } from '@/lib/seo';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Team from '@/blocks/shared/Team/Team.astro';
import CtaBanner from '@/components/layout/CtaBanner.astro';
import LeadForm from '@/blocks/landing-state/LeadForm/LeadForm.astro';
import RelatedLinks from '@/blocks/shared/RelatedLinks/RelatedLinks.astro';
import { Clients, ServicesList, IndustriesGrid, Cases } from '@/blocks/home';
import { HeroState, Cities, Commitments, FaqSection } from '@/blocks/landing-state';
import { Journey } from '@/blocks/industry';

interface Props {
  state: State;
}

const { state } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = state.copy[lang];
const t = UI[lang];
const url = `${SITE.url}${statePath(state, lang)}`;
const home = `${SITE.url}${lang === 'en' ? '/en/' : '/'}`;

// El nombre y el enlace son los del servicio; el texto, el de este estado (único: nada de resúmenes compartidos)
const serviceRows = SERVICES.map((item) => ({
  title: item.copy[lang].name,
  ...copy.services.items[item.id as ServiceId],
  href: servicePath(item, lang),
}));

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: copy.serviceName,
  description: copy.seo.description,
  url,
  serviceType: t.services,
  provider: { '@id': ORG_ID },
  areaServed: [
    {
      '@type': 'State',
      name: state.name,
      geo: { '@type': 'GeoCoordinates', latitude: state.geo.latitude, longitude: state.geo.longitude },
    },
    ...state.areas.map((name) => ({ '@type': 'City', name })),
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: copy.serviceName,
    itemListElement: serviceRows.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: item.title, description: item.text, url: `${SITE.url}${item.href}` },
    })),
  },
};

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: copy.process.heading.replaceAll('*', ''),
  description: copy.howToDescription,
  step: copy.process.steps.map((step) => ({ '@type': 'HowToStep', name: step.name, text: step.text })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: home },
    { '@type': 'ListItem', position: 2, name: stateName(state, lang), item: url },
  ],
};

// Al final: otros 6 estados + el índice, y las industrias, en etiquetas (los servicios ya van arriba, con su descripción). Con un
// solo estado publicado el grupo de estados no se pinta y quedan las industrias: la página nunca se queda sin enlaces
const siblings = siblingStates(state).map((item) => ({ href: statePath(item, lang), label: item.copy[lang].linkLabel }));
const related = [
  { label: t.nav.states, items: siblings.length ? [...siblings, { href: statesPath(lang), label: t.footer.allStates }] : [] },
  { label: t.nav.industries, items: INDUSTRY_PAGES.map((item) => ({ href: servicePath(item, lang), label: item.copy[lang].name })) },
];
---

<Layout title={copy.seo.title} description={copy.seo.description} structuredData={[service, howTo, breadcrumb, faqSchema(copy.faq.items)]}>
  <Header overlay />
  <main id="main-content">
    {/* Orden propio, distinto de las landings de aurin.mx. Ritmo: nunca más de dos negras seguidas. Hero y logos (negras) →
        servicios (blanca) → industrias y casos (negras) → regiones (blanca) → proceso (lima) → por escrito (negra) →
        equipo (blanca) → FAQ y cierre (negras) */}
    <HeroState hero={copy.hero} photo="st-beacon" trust />
    <Clients clients={HOME[lang].clients} />
    <ServicesList services={{ ...copy.services, items: serviceRows }} />
    <IndustriesGrid industries={copy.sectors} />
    <Cases cases={{ ...copy.cases, link: t.caseLink, items: caseCards(copy.cases.ids, lang) }} />
    <Cities cities={copy.cities} />
    <Journey {...copy.process} />
    <Commitments commitments={copy.commitments} />
    <Team compact />
    <FaqSection faq={copy.faq} />
    <CtaBanner {...copy.cta}><LeadForm source={`landing-${state.id}`} intro={false} /></CtaBanner>
    <RelatedLinks {...t.related} groups={related} />
  </main>
  <Footer minimal />
</Layout>

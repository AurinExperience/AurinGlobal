---
/**
 * GA4 y Microsoft Clarity con consentimiento: el mismo script que aurin.mx (Layout.astro de allá),
 * sin la atribución de leads ni el registro de decisiones en la hoja de Google.
 * Los IDs son de aurin.consulting (NUNCA los de aurin.mx: mezclarían los datos de los dos sitios) y viven en
 * variables de Vercel: PUBLIC_GA4_ID ("G-…") y PUBLIC_CLARITY_ID. Sin ninguna, no se pinta nada
 * (ni este script ni el aviso de cookies).
 *
 * El aviso sale a todos hasta que eligen; lo que cambia por región es qué pasa mientras tanto:
 * - Europa (EEE, Reino Unido, Suiza) y Canadá: GA4 y Clarity solo con "Aceptar" (opt-in, RGPD/Ley 25).
 * - Resto (EE. UU., México, Latinoamérica): activas por defecto y se apagan desde
 *   "Preferencias de cookies" (opt-out). La señal GPC del navegador cuenta como "no".
 * La elección vive en localStorage; window.aurinSetConsent(true|false) la cambia.
 * window.aurinTrack(evento, params) manda un evento a los dos (los formularios lo usan).
 */
import { ANALYTICS_ON } from '@/config/site';

const GA = import.meta.env.PUBLIC_GA4_ID ?? '';
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID ?? '';
---

{ANALYTICS_ON && (
  <script is:inline define:vars={{ GA, CLARITY }}>
    var KEY = 'aurin-consent';
    // "granted|fecha" o "denied|fecha"; a los 12 meses se vuelve a preguntar (lo que piden AEPD y CNIL)
    var choice = null;
    try {
      var saved = (localStorage.getItem(KEY) || '').split('|');
      if (Date.now() - Number(saved[1]) < 365 * 864e5) choice = saved[0];
    } catch (e) {}
    var tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
    // ponytail: la zona horaria hace de país (sin IP, para no partir la caché del CDN por país);
    // con VPN o reloj mal puesto puede fallar. Si hace falta precisión: x-vercel-ip-country en un endpoint.
    var optIn = /^(Europe\/|Arctic\/|Atlantic\/(Canary|Madeira|Azores|Reykjavik|Faroe)|Asia\/(Nicosia|Famagusta)|Indian\/(Reunion|Mayotte)|America\/(Martinique|Guadeloupe|Cayenne|Toronto|Montreal|Vancouver|Edmonton|Winnipeg|Halifax|St_Johns|Regina|Moncton|Glace_Bay|Goose_Bay|Whitehorse|Dawson|Dawson_Creek|Fort_Nelson|Creston|Yellowknife|Iqaluit|Rankin_Inlet|Cambridge_Bay|Inuvik|Swift_Current|Atikokan|Blanc-Sablon|Nipigon|Thunder_Bay|Rainy_River|Pangnirtung|Resolute))/.test(tz);
    var granted = choice ? choice === 'granted' : !optIn && !navigator.globalPrivacyControl;
    window.aurinConsent = { granted: granted, ask: !choice, optIn: optIn };

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    function consentState(on) {
      var v = on ? 'granted' : 'denied';
      return { analytics_storage: v, ad_storage: v, ad_user_data: v, ad_personalization: v };
    }
    gtag('consent', 'default', consentState(granted));
    gtag('js', new Date());
    if (GA) gtag('config', GA);

    // Google tag diferido: en el <head> se come segundos de CPU y frena el LCP.
    // El dataLayer encola los gtag() tempranos, así que no se pierden eventos.
    var gtagLoaded = false;
    function loadGtag() {
      if (!GA || gtagLoaded || !window.aurinConsent.granted) return;
      gtagLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA;
      document.head.appendChild(s);
    }
    ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) {
      addEventListener(e, loadGtag, { once: true, passive: true });
    });
    addEventListener('load', function () {
      if (window.requestIdleCallback) requestIdleCallback(loadGtag, { timeout: 3000 });
      else setTimeout(loadGtag, 3000);
    });

    // Clarity, snippet oficial. No se difiere: graba desde el primer cuadro.
    function loadClarity() {
      if (!CLARITY || window.clarity) return;
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", CLARITY);
      clarity('consentv2', { ad_Storage: 'granted', analytics_Storage: 'granted' });
    }
    if (granted) loadClarity();

    window.aurinTrack = function (event, params) {
      gtag('event', event, Object.assign({ transport_type: 'beacon' }, params));
      if (window.clarity) clarity('event', event);
    };

    window.aurinSetConsent = function (on) {
      try { localStorage.setItem(KEY, (on ? 'granted' : 'denied') + '|' + Date.now()); } catch (e) {}
      window.aurinConsent = { granted: on, ask: false, optIn: optIn };
      gtag('consent', 'update', consentState(on));
      if (on) {
        loadGtag();
        loadClarity();
        return;
      }
      if (window.clarity) {
        clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
        clarity('consent', false);
      }
      // Borra las cookies de GA4 y Clarity que ya se hubieran puesto
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (!/^(_ga|_clck|_clsk|CLID|MUID|ANONCHK|SM$)/.test(name)) return;
        [location.hostname, '.' + location.hostname.replace(/^www\./, '')].forEach(function (domain) {
          document.cookie = name + '=; Max-Age=0; path=/; domain=' + domain;
        });
        document.cookie = name + '=; Max-Age=0; path=/';
      });
    };
  </script>
)}
